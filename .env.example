# Copy to .env.local and fill values. Never commit real secrets.

# --- Site ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- CMS (News, Our Project, mega-menu banner) ---
CMS_API_URL=https://cms.gonline.id
CMS_BRAND_ID=gec
# Optional draft preview: /news/{slug}?preview=1&token=<same value>
# CMS_PREVIEW_SECRET=

# --- Google Sheets (products / legacy projects) ---
GOOGLE_TYPE=service_account
GOOGLE_PROJECT_ID=
GOOGLE_PRIVATE_KEY_ID=
GOOGLE_PRIVATE_KEY=
GOOGLE_CLIENT_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_UNIVERSE_DOMAIN=googleapis.com
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE_MASTER=
GOOGLE_SHEET_RANGE_CONTENT=
GOOGLE_SHEET_RANGE_IMAGES=
GOOGLE_SHEET_RANGE_SPEC=
GOOGLE_SHEET_RANGE_TABLE=
GOOGLE_SHEET_RANGE_PROJECTS=

# --- Contact form (Gmail) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
